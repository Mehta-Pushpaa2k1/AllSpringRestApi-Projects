<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Define Payment Beans -->
    <bean id="upi" class="com.jsp.assignment9.Model.UPIPayment"/>
    <bean id="card" class="com.jsp.assignment9.Model.CardPayment"/>
    <bean id="netBanking" class="com.jsp.assignment9.Model.NetBankingPayment"/>

    <!-- Configure OrderService with UPI Payment -->
    <bean id="orderService" class="com.jsp.assignment9.Model.OrderService">
        <property name="paymentService" ref="upi"/>
    </bean>

</beans>